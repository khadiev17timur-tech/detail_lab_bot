# Скопируйте этот файл в .env и заполните. Файл .env НЕ коммитьте.

# Токен бота от @BotFather (формат 123456789:AA...)
BOT_TOKEN=

# Telegram ID администраторов через запятую (узнать свой ID: бот @userinfobot)
ADMIN_IDS=

# --- необязательно -------------------------------------------------------
# Путь к базе SQLite (по умолчанию data/detail_lab.db).
# На сервере: DATABASE_PATH=/var/lib/detail-lab/detail_lab.db  (старое имя DB_PATH тоже работает)
# DATABASE_PATH=data/detail_lab.db
# Уровень логов: DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO

# Контакты студии (если пусто — берутся демо-значения из content/studio.py)
# MANAGER_USERNAME=your_manager_username
# STUDIO_PHONE=+7 (900) 000-00-00
# STUDIO_ADDRESS=г. Москва, ул. Пример, 1
# STUDIO_HOURS=Ежедневно, 10:00–20:00
# MAP_URL=https://maps.example.com/your-studio
# WEBSITE_URL=https://example.com
# TIMEZONE=Europe/Moscow

# true — в боте показываются пометки «демо-версия»; false — для боевого запуска
# DEMO_MODE=true
